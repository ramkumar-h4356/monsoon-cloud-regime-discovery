# Raw data: preserve folder structure, ignore actual files
raw_data/**
!raw_data/**/
!raw_data/**/.gitkeep

# Generated data: preserve folder structure, ignore actual files
data/**
!data/**/
!data/**/.gitkeep
!data/interim/ceres_seasonal/seasonal_manifest.csv

# NetCDF and compressed scientific datasets
*.nc
*.nc4
*.cdf
*.gz

# Temporary files
*.tmp
*.tmp.nc
data/interim/_ceres_temp/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/

# IDE and operating system
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs
*.log

# Large model artifacts
*.pkl
*.joblib
*.h5
*.keras
*.pt
*.pth
